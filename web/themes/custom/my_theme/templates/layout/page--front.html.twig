{#
/**
 * @file
 * Theme implementation to display the front page.
 */
#}
<div class="layout_container">
  <header class="header" role="banner">
    <div class="header_inner">
      <a href="{{ path('<front>') }}" class="header_logo">
        <span>Sample Corp.</span>
      </a>
      <nav class="header_nav" aria-label="{{ 'Main navigation'|t }}">
        {{ page.primary_menu }}
      </nav>
    </div>
  </header>

  <main class="main" role="main">
    <a id="main-content" tabindex="-1"></a>

    {# Hero Section #}
    <section class="hero">
      <div class="hero_inner">
        <h1 class="hero_ttl">
          {{ 'ビジネスの'|t }}<span class="hero_ttl-accent">{{ '成長'|t }}</span>{{ 'を'|t }}<br>
          {{ '共に実現するパートナー'|t }}
        </h1>
        <p class="hero_desc">
          {{ '私たちは、お客様の課題を深く理解し、最適なソリューションで解決へと導きます。'|t }}<br>
          {{ '信頼と実績で、あなたのビジネスを次のステージへ。'|t }}
        </p>
        <div class="hero_actions">
          <a href="{{ path('entity.webform.canonical', {'webform': 'contact'}) }}" class="btn btn-primary btn-lg">{{ 'お問い合わせ'|t }}</a>
          <a href="{{ path('entity.node.canonical', {'node': 2}) }}" class="btn btn-secondary btn-lg">{{ '詳しく見る'|t }}</a>
        </div>
      </div>
    </section>

    {# News Section #}
    <section class="section">
      <div class="section_inner">
        <header class="section_header">
          <h2 class="section_ttl">{{ 'お知らせ'|t }}</h2>
          <p class="section_lead">
            {{ '最新のニュースやイベント情報をお届けします。'|t }}
          </p>
        </header>

        {# News items will be rendered via Views block #}
        {{ drupal_view('news', 'block_latest') }}

        <div class="section_more">
          <a href="{{ path('view.news.page_1') }}" class="btn btn-secondary">{{ 'お知らせ一覧を見る'|t }}</a>
        </div>
      </div>
    </section>

    {# Service Section #}
    <section class="section section-gray">
      <div class="section_inner">
        <header class="section_header">
          <h2 class="section_ttl">{{ 'サービス'|t }}</h2>
          <p class="section_lead">
            {{ 'お客様のニーズに合わせた幅広いサービスで、ビジネスの成功をサポートいたします。'|t }}
          </p>
        </header>
        <ul class="service_list">
          <li class="service_item">
            <div class="service_icon" aria-hidden="true">
              {% include '@my_theme/icons/edit.svg.twig' ignore missing %}
            </div>
            <h3 class="service_ttl">{{ 'コンサルティング'|t }}</h3>
            <p class="service_desc">
              {{ '課題分析から戦略立案まで、経験豊富なコンサルタントがお客様のビジネスを丁寧にサポートいたします。'|t }}
            </p>
          </li>
          <li class="service_item">
            <div class="service_icon" aria-hidden="true">
              {% include '@my_theme/icons/monitor.svg.twig' ignore missing %}
            </div>
            <h3 class="service_ttl">{{ 'システム開発'|t }}</h3>
            <p class="service_desc">
              {{ '業務効率化や新規事業に必要なシステムを、企画からデリバリーまでワンストップでご提供いたします。'|t }}
            </p>
          </li>
          <li class="service_item">
            <div class="service_icon" aria-hidden="true">
              {% include '@my_theme/icons/users.svg.twig' ignore missing %}
            </div>
            <h3 class="service_ttl">{{ '人材支援'|t }}</h3>
            <p class="service_desc">
              {{ '専門スキルを持つ人材のご紹介や、チーム体制の構築支援など、人材面からビジネスを支援いたします。'|t }}
            </p>
          </li>
        </ul>
      </div>
    </section>

    {# Feature Section #}
    <section class="section">
      <div class="section_inner">
        <header class="section_header">
          <h2 class="section_ttl">{{ '選ばれる理由'|t }}</h2>
          <p class="section_lead">
            {{ '多くのお客様に選ばれ続ける、私たちの強みをご紹介します。'|t }}
          </p>
        </header>
        <ul class="feature_list">
          <li class="feature_item">
            <div class="feature_icon" aria-hidden="true">
              {% include '@my_theme/icons/check-circle.svg.twig' ignore missing %}
            </div>
            <div class="feature_content">
              <h3 class="feature_ttl">{{ '豊富な実績'|t }}</h3>
              <p class="feature_desc">
                {{ '創業以来、500社以上の企業様を支援してまいりました。様々な業界での経験を活かし、最適なソリューションをご提案します。'|t }}
              </p>
            </div>
          </li>
          <li class="feature_item">
            <div class="feature_icon" aria-hidden="true">
              {% include '@my_theme/icons/clock.svg.twig' ignore missing %}
            </div>
            <div class="feature_content">
              <h3 class="feature_ttl">{{ '迅速な対応'|t }}</h3>
              <p class="feature_desc">
                {{ 'お問い合わせから24時間以内にご連絡いたします。スピード感を持って、お客様の課題解決に取り組みます。'|t }}
              </p>
            </div>
          </li>
          <li class="feature_item">
            <div class="feature_icon" aria-hidden="true">
              {% include '@my_theme/icons/heart.svg.twig' ignore missing %}
            </div>
            <div class="feature_content">
              <h3 class="feature_ttl">{{ '手厚いサポート'|t }}</h3>
              <p class="feature_desc">
                {{ 'プロジェクト完了後も継続的なサポートをご提供。長期的なパートナーとしてお客様に寄り添います。'|t }}
              </p>
            </div>
          </li>
          <li class="feature_item">
            <div class="feature_icon" aria-hidden="true">
              {% include '@my_theme/icons/star.svg.twig' ignore missing %}
            </div>
            <div class="feature_content">
              <h3 class="feature_ttl">{{ '高い専門性'|t }}</h3>
              <p class="feature_desc">
                {{ '各分野のエキスパートが在籍。最新の知見と技術で、質の高いサービスをお届けします。'|t }}
              </p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    {# CTA Section #}
    <section class="cta">
      <div class="cta_inner">
        <h2 class="cta_ttl">{{ 'まずはお気軽にご相談ください'|t }}</h2>
        <p class="cta_desc">
          {{ 'お客様のビジネスに関するお悩みやご要望をお聞かせください。'|t }}<br class="pc-only">
          {{ '専門スタッフが丁寧にご対応いたします。'|t }}
        </p>
        <div class="cta_actions">
          <a href="{{ path('entity.webform.canonical', {'webform': 'contact'}) }}" class="btn btn-white btn-lg">{{ 'お問い合わせはこちら'|t }}</a>
        </div>
      </div>
    </section>

    {# Drupal content region (for additional blocks) #}
    {% if page.content %}
      <div class="page_content">
        {{ page.content }}
      </div>
    {% endif %}
  </main>

  <footer class="footer" role="contentinfo">
    <div class="footer_inner">
      <div class="footer_content">
        <div class="footer_brand">
          <p class="footer_logo">Sample Corp.</p>
          <p class="footer_tagline">{{ 'ビジネスを成功に導くパートナー'|t }}</p>
        </div>
        <nav class="footer_nav" aria-label="{{ 'Footer navigation'|t }}">
          {{ page.footer }}
        </nav>
      </div>
      <p class="footer_copyright">
        <small>&copy; {{ 'now'|date('Y') }} Sample Corp. All rights reserved.</small>
      </p>
    </div>
  </footer>
</div>
