{#
/**
 * @file
 * News card component template.
 *
 * Available variables:
 * - url: Link to the news article
 * - image: Image render array or URL
 * - date: Publication date
 * - category: Category name
 * - title: Article title
 * - summary: Article summary/teaser
 */
#}
<article class="news_card">
  <a href="{{ url }}" class="news_card_link">
    <div class="news_card_thumb">
      {% if image %}
        {% if image.uri is defined %}
          <img src="{{ file_url(image.uri) }}" alt="{{ image.alt|default('') }}" width="400" height="240" loading="lazy">
        {% elseif image is iterable %}
          {{ image }}
        {% else %}
          <img src="{{ image }}" alt="" width="400" height="240" loading="lazy">
        {% endif %}
      {% else %}
        <img src="https://placehold.co/400x240/e2e8f0/64748b?text=No+Image" alt="" width="400" height="240" loading="lazy">
      {% endif %}
    </div>
    <div class="news_card_body">
      <div class="news_card_meta">
        {% if date %}
          <time class="news_card_date" datetime="{{ date|date('Y-m-d') }}">{{ date|date('Y.m.d') }}</time>
        {% endif %}
        {% if category %}
          <span class="news_card_category">{{ category }}</span>
        {% endif %}
      </div>
      <h3 class="news_card_ttl">{{ title }}</h3>
      {% if summary %}
        <p class="news_card_desc">{{ summary|striptags|length > 80 ? summary|striptags|slice(0, 80) ~ '...' : summary|striptags }}</p>
      {% endif %}
    </div>
  </a>
</article>
