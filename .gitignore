# Drupal
/web/core
/web/modules/contrib
/web/themes/contrib
/web/profiles/contrib
/web/libraries
/web/sites/*/files
/web/sites/*/private
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.yml
/vendor

# Frontend build output in theme
/web/themes/custom/my_theme/css/*.css
/web/themes/custom/my_theme/css/*.css.map
/web/themes/custom/my_theme/js/*.js
/web/themes/custom/my_theme/js/*.js.map
!/web/themes/custom/my_theme/css/.gitkeep
!/web/themes/custom/my_theme/js/.gitkeep

# Frontend
/frontend/node_modules
/frontend/dist

# IDE
.idea
.vscode
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

/.editorconfig
/.gitattributes
